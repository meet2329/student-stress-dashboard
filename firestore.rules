rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Shared Dashboards: Anyone with the share link can read; anyone can create
    match /shared_dashboards/{shareId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.auth != null || resource.data.owner.uid == 'anonymous' || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'lastViewedAt', 'isRevoked', 'revokedAt']);
      allow delete: if request.auth != null;
    }

    // Default rule for other documents
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
